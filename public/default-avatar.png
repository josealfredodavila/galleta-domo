<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <!-- Fondo circular verde bosque -->
    <circle cx="100" cy="100" r="100" fill="#0B3D2E" />
    <circle cx="100" cy="100" r="92" fill="#1A6B4F" />
    
    <!-- Círculo interior -->
    <circle cx="100" cy="100" r="85" fill="#0B3D2E" />
    
    <!-- Ojos -->
    <ellipse cx="75" cy="88" rx="12" ry="14" fill="#FFFFFF" />
    <ellipse cx="125" cy="88" rx="12" ry="14" fill="#FFFFFF" />
    <circle cx="78" cy="90" r="6" fill="#062A1F" />
    <circle cx="128" cy="90" r="6" fill="#062A1F" />
    <circle cx="80" cy="87" r="2" fill="#FFFFFF" />
    <circle cx="130" cy="87" r="2" fill="#FFFFFF" />
    
    <!-- Sonrisa -->
    <path d="M70 115 Q100 145 130 115" 
          stroke="#D4A857" 
          stroke-width="5" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Ceja izquierda -->
    <path d="M62 70 Q75 62 88 70" 
          stroke="#D4A857" 
          stroke-width="3" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Ceja derecha -->
    <path d="M112 70 Q125 62 138 70" 
          stroke="#D4A857" 
          stroke-width="3" 
          fill="none" 
          stroke-linecap="round" />
    
    <!-- Corona/Detalle con emoji de galleta -->
    <text x="100" y="38" text-anchor="middle" font-size="28">🍪</text>
    
    <!-- Nombre de la marca -->
    <text x="100" y="178" text-anchor="middle" 
          font-family="'Segoe UI', Arial, sans-serif" 
          font-size="14" 
          fill="#D4A857" 
          font-weight="600" 
          letter-spacing="2">Sariel's</text>
    
    <!-- Pequeño destello -->
    <circle cx="50" cy="50" r="4" fill="rgba(255,255,255,0.3)" />
    <circle cx="45" cy="45" r="2" fill="rgba(255,255,255,0.2)" />
</svg>
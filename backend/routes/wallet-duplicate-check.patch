// Add check for duplicate wallet before marking nonce used
const { data: existing, error: existingErr } = await supabaseAdmin
    .from('usuarios')
    .select('id')
    .eq('wallet_address', walletAddress)
    .neq('id', userId)
    .maybeSingle();

if (existingErr) {
    console.error('❌ Error checking existing wallet:', existingErr);
    return res.status(500).json({ error: 'Error interno verificando wallet' });
}

if (existing) {
    return res.status(409).json({ error: 'Esta wallet ya está vinculada a otra cuenta' });
}

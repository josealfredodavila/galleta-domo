/* ================================================================
   PERFIL-PUBLICO.CSS — Csariel's
   ================================================================ */

/* Estados de carga visuales */
.pv-estado { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-size: .75rem; color: #9fb3c8; }
.pv-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.pv-dot.activo { background: var(--success, #00d68f); box-shadow: 0 0 8px var(--success, #00d68f); }
.pv-dot.inactivo { background: var(--text-muted, #6b7d90); }

/* Wallet */
.pv-wallet {
    margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px;
    border-radius: 999px; border: 1px solid rgba(0, 229, 255, .35); background: rgba(0, 229, 255, .05);
    color: #5cc8ff; font-family: monospace; font-size: .72rem; cursor: pointer;
}

/* Acciones */
.pv-acciones { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 12px; }
.pv-volver { width: 100%; justify-content: center; margin-top: 14px; }

/* Pasaporte */
#pvPasaporte { margin: 0 0 12px; }
.pv-pasaporte { position: relative; padding: 18px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.09); color: #f0f4f8; }
.pv-pasaporte-sello {
    display: inline-flex; align-items: center; gap: 6px; font-family: 'Orbitron', monospace;
    font-size: .6rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #D4AF37; margin-bottom: 10px;
}
.pv-pasaporte-titulo { font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
.pv-pasaporte-sub { font-size: .8rem; color: #9fb3c8; line-height: 1.5; }
.pv-pasaporte-verif { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font-size: .72rem; font-weight: 600; color: #00d68f; }

/* Encabezados de sección (amigos y publicaciones) */
.pv-pub-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px 6px; }
.pv-pub-head h3 { margin: 0; font-family: Orbitron, monospace; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #bfefff; }
.pv-pub-contador { font-size: .7rem; color: #6f8ba0; }
.pv-pub-msg { margin: 14px 16px; text-align: center; font-size: .82rem; color: #8aa8b8; line-height: 1.5; }

/* Amigos */
#pvAmigosLista { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; padding: 4px 16px 16px; }
#pvAmigosLista .pv-pub-msg { grid-column: 1 / -1; margin: 6px 0; }
.pv-amigo-card {
    display: flex; align-items: center; gap: 10px; min-width: 0; padding: 10px; border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.03);
    color: inherit; text-decoration: none; transition: border-color .18s ease, background .18s ease;
}
.pv-amigo-card:hover, .pv-amigo-card:focus-visible { border-color: rgba(0, 229, 255, .4); background: rgba(0, 229, 255, .05); }
.pv-amigo-av {
    width: 40px; height: 40px; flex: 0 0 40px; border-radius: 50%; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #0F2D1A, #D4AF37); color: #fff; font-weight: 700;
    border: 1.5px solid rgba(0, 229, 255, .4);
}
.pv-amigo-av img { width: 100%; height: 100%; object-fit: cover; }
.pv-amigo-info { min-width: 0; flex: 1; }
.pv-amigo-nombre { font-size: .82rem; font-weight: 700; color: #f5fbff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pv-amigo-sub { font-size: .7rem; color: #5cc8ff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Posts */
.pv-post { display: flex; gap: 12px; padding: 14px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
.pv-post-av {
    width: 42px; height: 42px; flex: 0 0 42px; border-radius: 50%; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #0F2D1A, #D4AF37); color: #fff; font-weight: 700;
    border: 1.5px solid rgba(0, 229, 255, .45);
}
.pv-post-av img { width: 100%; height: 100%; object-fit: cover; }
.pv-post-meta { min-width: 0; flex: 1; }
.pv-post-nombre { font-weight: 700; font-size: .9rem; color: #f5fbff; }
.pv-post-sub { font-size: .7rem; color: #6f8ba0; margin-top: 2px; }
.pv-post-texto { margin-top: 8px; font-size: .92rem; line-height: 1.55; color: #d5e4ef; white-space: pre-wrap; word-break: break-word; }

/* Multimedia */
.pv-post-img { display: block; width: 100%; height: auto; max-height: 80vh; object-fit: contain; border-radius: 14px; margin-top: 12px; cursor: zoom-in; }
.pv-post-video { display: block; width: 100%; height: auto; max-height: 80vh; object-fit: contain; border-radius: 14px; margin-top: 12px; background: #000; }
.pv-post-audio { display: block; width: 100%; margin-top: 12px; border-radius: 10px; }
.pv-post-aviso { margin-top: 8px; font-size: .7rem; color: #f7d44a; }

/* Barra de reacciones */
.pv-post-barra {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, 0.05);
}
.pv-reacciones { display: flex; gap: 6px; flex-wrap: wrap; }
.pv-btn-reaccion {
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.03);
    color: #b7d0e2; font-size: .8rem; cursor: pointer;
}
.pv-btn-reaccion.activo { border-color: rgba(0, 229, 255, .5); background: rgba(0, 229, 255, .12); color: #5cc8ff; }
.pv-btn-reaccion:disabled { opacity: .5; cursor: wait; }
.pv-btn-comentar {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.03);
    color: #b7d0e2; font-size: .8rem; cursor: pointer;
}

/* Comentarios */
.pv-comentarios {
    margin-top: 12px; padding: 12px 14px; border-radius: 12px;
    background: rgba(5, 10, 20, 0.55); border: 1px solid rgba(255, 255, 255, 0.06);
}
.pv-comentarios[hidden] { display: none; }
.pv-comentarios-lista { display: flex; flex-direction: column; gap: 10px; max-height: 240px; overflow-y: auto; padding-right: 4px; }
.pv-comentario-item { font-size: .85rem; color: #d5e4ef; line-height: 1.45; }
.pv-comentario-autor { font-weight: 700; color: #5cc8ff; margin-right: 6px; }
.pv-comentario-form { display: flex; gap: 8px; margin-top: 12px; }
.pv-comentario-input {
    flex: 1; min-width: 0; padding: 8px 12px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15); background: rgba(255, 255, 255, 0.04); color: #fff; font-size: .85rem;
}
.pv-comentario-input:disabled { opacity: .6; }
.pv-mas { display: block; margin: 14px auto 16px; }

/* Lightbox */
.pv-lightbox { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(2, 6, 14, 0.95); }
.pv-lightbox[hidden] { display: none; }
.pv-lightbox-inner { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.pv-lightbox-inner img, .pv-lightbox-inner video { max-width: 95vw; max-height: 90vh; border-radius: 12px; display: block; object-fit: contain; }
.pv-lightbox-cerrar {
    position: absolute; top: 16px; right: 16px; padding: 6px 14px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.25); background: rgba(15,23,42,.9); color: #fff; cursor: pointer; z-index: 10;
}

/* Mensajes */
.pv-mensaje { text-align: center; padding: 30px 12px; }
.pv-mensaje .btn { margin-top: 14px; }

/* Accesibilidad */
@media (prefers-reduced-motion: reduce) {
    .perfil-header #pvHandle, .perfil-header #pvHandle::before { animation: none !important; }
    .pv-amigo-card { transition: none; }
}